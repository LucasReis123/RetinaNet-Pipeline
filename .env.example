# BUILD DA IMAGEM

PYTHON_VERSION=3.12

# CUDA da imagem base e do PyTorch (têm que bater):
# 12.6.3/cu126 | 12.8.1/cu128 | 12.4.1/cu124 | 11.8.0/cu118
CUDA_VERSION=12.6.3
TORCH_CUDA=cu126

# Versões do PyTorch disponíveis para o TORCH_CUDA escolhido
TORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1

# Commit, tag ou branch do Detectron2
DETECTRON2_REF=main

# Arquiteturas de GPU compiladas: 7.5 = RTX 20xx, 8.6 = RTX 30xx, 8.9 = RTX 40xx, 12.0 = RTX 50xx
# Só a da sua GPU (ex.: 8.6) deixa o build bem mais rápido
TORCH_CUDA_ARCH_LIST=7.5;8.0;8.6;8.9;9.0+PTX

# Processos de compilação em paralelo (reduza se faltar RAM no build)
MAX_JOBS=8

# RECURSOS DO CONTAINER

# all, 1, 2, ...
GPU_COUNT=all
# memória compartilhada para os workers do dataloader
SHM_SIZE=8gb
# dono dos arquivos gerados no host (id -u)
UID=1000
# (id -g)
GID=1000
# pasta no host com os datasets
DATASET_HOST_DIR=../Dateset

# Dataset
DATASET_NAME=Torso21
VAL_RATIO=0.20
TEST_RATIO=0.10
FORCE_SINGLE_CLASS=false
SINGLE_CLASS_NAME=object
SINGLE_CLASS_ID=0

# Modelo
# Config do model zoo: COCO-Detection/retinanet_R_50_FPN_3x.yaml | retinanet_R_101_FPN_3x.yaml
MODEL_CONFIG=COCO-Detection/retinanet_R_50_FPN_3x.yaml

# Treinamento
# Detectron usa iterações (1 época = imagens de treino / IMGS_PER_BATCH)
MAX_ITER=300
BASE_LR=0.00025
IMGS_PER_BATCH=2
NUM_WORKERS=2

# cuda | cpu
DEVICE=cuda

# -1 = aleatório
SEED=-1

# Avaliação
# confiança mínima das predições
SCORE_THRESH=0.5

# Saída
# vazio = RetinaNet_Treinamentos_<DATASET_NAME>
OUTPUT_DIR=

# Etapas
FIX_DATASET=true
DO_TRAIN=true
DO_EVAL=true
DO_ANALYSIS=true
